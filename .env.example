# Public URL of the site (used for metadata).
NEXT_PUBLIC_SITE_URL=https://themeflix.com

# Stripe secret key. Leave empty to keep checkout switched off; use sk_test_... while testing.
STRIPE_SECRET_KEY=

# Set to "true" once Stripe Tax is set up in the Stripe dashboard to add US sales tax at checkout.
STRIPE_AUTOMATIC_TAX=false

# Any long random string; used to derive license keys from purchases. Never change it after launch.
LICENSE_SECRET=
